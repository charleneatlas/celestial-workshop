    - target: {fileID: 2066805255561781319, guid: d977a91ede3020d48acc887216c8122e, type: 3}
      propertyPath: m_text
      value: '<b>Pinch</b> (thumb touching a fingertip) is the primary select gesture
        on Quest, and index pinch is ML-backed for extra reliability.

        Read
        <color=#64B5F6>GetFingerIsPinching()</color> or a 0-1 <color=#64B5F6>GetFingerPinchStrength()</color>.

        <color=#8BC34A><b>Try:</b>
        pinch slowly, each sphere colors with your pinch strength.</color>'
      objectReference: {fileID: 0}
