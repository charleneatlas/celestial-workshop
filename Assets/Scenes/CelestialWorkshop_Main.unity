    - target: {fileID: 2066805255561781319, guid: d977a91ede3020d48acc887216c8122e, type: 3}
      propertyPath: m_text
      value: 'The runtime reports how reliable hand data is: <color=#64B5F6>IsTracked</color>,
        <color=#64B5F6>HandConfidence</color> (High / Low) and per-finger <color=#64B5F6>GetFingerConfidence()</color>.

