    - target: {fileID: 2066805255561781319, guid: d977a91ede3020d48acc887216c8122e, type: 3}
      propertyPath: m_text
      value: '<b>HandGrabInteractable</b> supports grab poses, finger constraints
        and use interactions.

        Each object grabs differently: plain grab,
        pinch pose, palm pose or both.

        <color=#8BC34A><b>Try:</b> grab the
        spray bottle and squeeze its trigger to spray.</color>'
      objectReference: {fileID: 0}
