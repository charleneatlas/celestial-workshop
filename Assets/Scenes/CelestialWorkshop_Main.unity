    - target: {fileID: 2066805255561781319, guid: d977a91ede3020d48acc887216c8122e, type: 3}
      propertyPath: m_text
      value: 'The Interaction SDK recognizes hand poses by combining checks:

        <color=#64B5F6>ShapeRecognizer</color>
        checks finger shape, <color=#64B5F6>TransformRecognizer</color> checks orientation,
        and an <color=#64B5F6>ActiveStateGroup</color> combines them.

        <color=#8BC34A><b>Try:</b>
        a right-hand thumbs-up lights shape, orientation, then both.</color>'
